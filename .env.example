# Prepended by the API client to the paths in the generated SDK, and the path the
# dev server proxies.
VITE_API_BASEURL="/api"

# Backend the dev server proxies to.
VITE_API_PROXY_TARGET=""

# Origin the dev proxy presents to the backend, so Sanctum treats dev requests as
# stateful and issues a session cookie.
VITE_API_STATEFUL_ORIGIN=""

VITE_API_CSRF_PATH="/sanctum/csrf-cookie"
